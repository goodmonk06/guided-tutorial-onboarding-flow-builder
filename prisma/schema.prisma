// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GuideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TriggerType {
  PAGE_LOAD
  ELEMENT_CLICK
  TIME_DELAY
  USER_EVENT
  MANUAL
}

enum EventType {
  GUIDE_STARTED
  GUIDE_COMPLETED
  GUIDE_SKIPPED
  STEP_VIEWED
  STEP_COMPLETED
  STEP_SKIPPED
  GUIDE_CREATED
  GUIDE_UPDATED
  GUIDE_DELETED
}

model Guide {
  id              String         @id @default(cuid())
  name            String
  key             String         @unique
  description     String?
  status          GuideStatus    @default(DRAFT)
  version         Int            @default(1)
  templateId      String?
  priority        Int            @default(0)
  tags            String?        // Comma-separated tags
  targetAudience  String?        // JSON for targeting rules
  styleId         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?

  steps           GuideStep[]
  versions        GuideVersion[]
  analytics       GuideAnalytics[]
  userProgress    UserProgress[]
  events          GuideEvent[]
  triggers        GuideTrigger[]
  template        GuideTemplate? @relation(fields: [templateId], references: [id])
  style           GuideStyle?    @relation(fields: [styleId], references: [id])

  @@index([key])
  @@index([status])
  @@index([templateId])
}

model GuideStep {
  id              String   @id @default(cuid())
  guideId         String
  orderIndex      Int
  selector        String
  contentMarkdown String
  placement       String   @default("bottom")
  routePath       String?
  metaJson        String?  // JSON for conditional logic, etc.
  delayMs         Int?     // Optional delay before showing step
  required        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, orderIndex])
}

model GuideTemplate {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String?
  category    String   @default("general")
  thumbnail   String?  // URL to template preview image
  config      String   // JSON template configuration
  usageCount  Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guides Guide[]

  @@index([category])
  @@index([key])
}

model GuideVersion {
  id          String   @id @default(cuid())
  guideId     String
  version     Int
  snapshot    String   // JSON snapshot of guide + steps
  changeLog   String?  // Description of changes
  createdBy   String?  // User ID who created this version
  createdAt   DateTime @default(now())

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, version])
  @@index([guideId])
}

model UserProgress {
  id             String    @id @default(cuid())
  guideId        String
  userId         String
  currentStepId  String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  skippedAt      DateTime?
  lastViewedAt   DateTime  @default(now())
  stepsCompleted Int       @default(0)
  stepsTotal     Int
  metadata       String?   // JSON for additional tracking data

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, userId])
  @@index([userId])
  @@index([guideId])
}

model GuideAnalytics {
  id              String   @id @default(cuid())
  guideId         String
  date            DateTime @default(now())
  impressions     Int      @default(0)
  starts          Int      @default(0)
  completions     Int      @default(0)
  skips           Int      @default(0)
  averageTimeMs   Int      @default(0)
  dropOffSteps    String?  // JSON array of step indices where users dropped off

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, date])
  @@index([guideId])
  @@index([date])
}

model GuideEvent {
  id        String    @id @default(cuid())
  guideId   String?
  eventType EventType
  userId    String?
  metadata  String?   // JSON event metadata
  timestamp DateTime  @default(now())

  guide Guide? @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
  @@index([eventType])
  @@index([timestamp])
  @@index([userId])
}

model GuideStyle {
  id              String   @id @default(cuid())
  name            String
  primaryColor    String   @default("#3b82f6")
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#111827")
  borderRadius    String   @default("12px")
  fontSize        String   @default("14px")
  customCss       String?  // Additional custom CSS
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guides Guide[]

  @@index([name])
}

model GuideTrigger {
  id          String      @id @default(cuid())
  guideId     String
  triggerType TriggerType
  config      String      // JSON configuration for trigger
  isActive    Boolean     @default(true)
  priority    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
  @@index([triggerType])
}
